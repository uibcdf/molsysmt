# .coveragerc

[run]
branch = True
source = molsysmt
relative_files = True
omit =
    */molecular_dynamics/*
    # Piped getter files: generated delegation code — all calls forward to
    # the piped form's getters; testing them individually is redundant.
    # Forms piped to molsysmt.Topology:
    */form/string_pdb_id/get_topological_attributes.py
    */form/string_alphafold_id/get_topological_attributes.py
    */form/string_pdb_text/get_topological_attributes.py
    */form/string_smiles/get_topological_attributes.py
    */form/file_pdb/get_topological_attributes.py
    */form/file_bcif/get_topological_attributes.py
    */form/file_bcif_gz/get_topological_attributes.py
    */form/file_cif/get_topological_attributes.py
    */form/file_cif_gz/get_topological_attributes.py
    */form/file_prmtop/get_topological_attributes.py
    */form/file_psf/get_topological_attributes.py
    */form/file_smi/get_topological_attributes.py
    */form/file_topology_yaml/get_topological_attributes.py
    */form/MDAnalysis_AtomGroup/get_topological_attributes.py
    */form/mmcif_PdbxContainers_DataContainer/get_topological_attributes.py
    */form/mmtf_MMTFDecoder/get_topological_attributes.py
    */form/molsysmt_GROFileHandler/get_topological_attributes.py
    */form/molsysmt_TopologyDict/get_topological_attributes.py
    */form/nglview_NGLWidget/get_topological_attributes.py
    */form/openff_Molecule/get_topological_attributes.py
    */form/openff_Topology/get_topological_attributes.py
    # Forms piped to openmm.Topology:
    */form/pdbfixer_PDBFixer/get_topological_attributes.py
    */form/openmm_Simulation/get_topological_attributes.py
    */form/openmm_Modeller/get_topological_attributes.py

[report]
show_missing = True

