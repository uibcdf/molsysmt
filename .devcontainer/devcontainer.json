{
  "name": "MolSysMT Dev",
  "build": { "dockerfile": "Dockerfile" },
  "runArgs": ["--gpus", "all"],
  "remoteUser": "vscode",

  "postCreateCommand": [
    "bash -lc 'micromamba env update -n base -f molsysmt/devtools/conda-envs/development_env.yaml'",
    "bash -lc 'pip install --no-deps --editable .'",
    "bash -lc 'python -m ipykernel install --user --name molsysmt --display-name \"Python (MolSysMT)\"'"
  ],

  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-toolsai.jupyter"],
      "settings": {
        "python.defaultInterpreterPath": "/opt/conda/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["-q"]
      }
    }
  }
}

